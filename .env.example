# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL (SQLite — hanya untuk development lokal):
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# PRODUCTION (Neon PostgreSQL — wajib untuk Vercel):
# Dapatkan dari: https://console.neon.tech → project → Connection string
# Gunakan "Pooled connection" untuk DATABASE_URL
# Gunakan "Direct connection" untuk DIRECT_URL
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimal 32 karakter random string
JWT_SECRET="replace-with-long-random-string-at-least-32-chars"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="strong-password-min-8-chars"

# ── Image Storage ─────────────────────────────────────────────────────────────
# Di Vercel, upload file tidak persistent. Gunakan Vercel Blob atau Cloudinary.
# Isi BLOB_READ_WRITE_TOKEN dari: Vercel Dashboard → Storage → Blob → Connect
# Atau gunakan Cloudinary: CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# (Opsional — jika tidak diisi, hanya URL eksternal yang bisa digunakan untuk gambar)
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."
